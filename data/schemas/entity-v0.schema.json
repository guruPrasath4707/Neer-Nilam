{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neer-nilam.local/schema/entity-v0.json",
  "title": "Neer-Nilam Entity v0",
  "type": "object",
  "required": ["id", "entity_type", "canonical_name", "verification_status"],
  "properties": {
    "id": {"type": "string"},
    "entity_type": {"type": "string"},
    "canonical_name": {"type": "string"},
    "alternate_names": {"type": "array", "items": {"type": "string"}},
    "geometry": {"type": ["object", "null"]},
    "geometry_type": {"type": ["string", "null"]},
    "spatial_reference": {"type": ["string", "null"]},
    "valid_from": {"type": ["string", "null"]},
    "valid_to": {"type": ["string", "null"]},
    "observation_time": {"type": ["string", "null"]},
    "document_time": {"type": ["string", "null"]},
    "ingestion_time": {"type": ["string", "null"]},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "asset_refs": {"type": "array", "items": {"type": "string"}},
    "rights_status": {"type": "string"},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "verification_status": {"type": "string"},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}